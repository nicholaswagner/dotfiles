#!/usr/bin/env bash


: "${DOTFILES:=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
if [[ -z "${THEME_GREY_3:-}" ]]; then
  set -a
  source "$DOTFILES/.env"
  set +a
fi




if [[ "$TERM_PROGRAM" == "tmux" ]]; then
    terminal_width=$(tmux display -p "#{pane_width}")
else
    terminal_width=$(tput cols 2)
fi

heatmap_width=80
imageCols=20
imageRows=20




HEATMAP_ARGS=("$@")

# detects terminal width and subtracts indent
# heatmap_offset=$(($(tput cols 2) - IMG_W + GUTTER))


# echo "terminal_width: $TERM_WIDTH 
# available_width: $AVAILABLE_WIDTH 
# IMG_W: $IMG_W"

# early return when inside vscode
if [ "$TERM_PROGRAM" = "vscode" ]; then
    return 0 2>/dev/null || exit 0
fi


# if [ -n "$TMUX_PANE" ] && [ "$TMUX_PANE" != "%0" ]; then
#     return 0 2>/dev/null || exit 0
# fi


indent=$(printf '%*s' $((imageCols)) '')
heatmap_width=$((terminal_width - imageCols))

# Capture heatmap output so we know how many rows it takes
# heatmap=$(gh-heatmap "${HEATMAP_ARGS[@]}" \
#     --empty="$THEME_GREY_3" \
#     --low="$THEME_ACCENT_4" \
#     --mid-low="$THEME_ACCENT_6" \
#     --mid="$THEME_ACCENT_8" \
#     --mid-high="$THEME_ACCENT_10" \
#     --max="$THEME_ACCENT_12" \
#     --label="$THEME_GREY_7" \
#     --month="$THEME_GREY_8" \
#     --total="$THEME_GREY_9" \
#     --width="$heatmap_width" \
#     --month-labels="none" \
#     --sep="")
    # --labels="none" \



heatmap=$(../ghg/ghg --max-columns="$heatmap_width")




n=$(printf '%s\n' "$heatmap" | wc -l | tr -d ' ')



# Print heatmap shifted right to leave room for the image
printf '%s\n' "$heatmap" | sed "s/^/$indent/"



args=(
    "${DOTFILES}/assets/pixelized.png"
    --size="20x20"
    --fit-width
    --margin-bottom=1
)
    # --size="${imageRows}x${n}"

if [[ "$HOST_TERM_PROGRAM" == "iTerm.app" ]]; then
    args+=("--format=iterm")
else
    args+=("--format=kitty")
fi

if [[ "$TERM_PROGRAM" == "tmux" ]]; then
    args+=("--passthrough=tmux")
fi



# Move cursor back up to the start of the block
printf '\033[%dA' "$(($n + 1))"
if [[ "$HOST_TERM_PROGRAM" == "iTerm.app" && -n "$TMUX" ]]; then
    show_tmux_iterm_img "${args[@]}"
else
    chafa "${args[@]}"
fi

# Let's use 'printf' to show exactly how the arguments are being received
# %q will escape special characters so you can see the boundaries
# printf "Args : %q\n" "${args[@]}"
# echo "---"
# echo "TERM: $TERM "
# echo "HOST TERM: $HOST_TERM "
# echo "TERM_PROGRAM: $TERM_PROGRAM "
# echo "HOST_TERM_PROGRAM: $HOST_TERM_PROGRAM "
# echo "---"
# echo "Terminal width: $terminal_width"

# exit 0